__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.venv/
venv/

# Downloaded / fine-tuned YOLO checkpoints and other model weights
*.pt
*.pth

# Data, exported YOLO datasets, and pipeline outputs
# NOTE: these are anchored to the repo root (leading "/") on purpose -- an
# earlier unanchored "data/" here matched ANY directory named "data" anywhere
# in the tree, which silently excluded src/transit/data/ (schema.py,
# mtmc_dataset.py, calibration.py, __init__.py) from every commit since the
# very first one. That subpackage was never on GitHub until this fix.
/data/
/outputs/
/datasets/

# smoke_test_video.py output -- large, regenerable locally, never commit by default
*_annotated.mp4
# Exception: this one is kept as a committed demo (H.264-encoded, ~38MB, well under
# GitHub's 100MB limit -- the mp4v-encoded output cv2.VideoWriter produces by default
# is ~110MB and must NOT be committed as-is; re-encode with ffmpeg/libx264 first).
!samples/yolo11x_smoke_test_cctv_footage_annotated.mp4
/runs/

# Additional stock-detector output variants and run logs -- same anchoring
# rationale as /outputs/ above; these are data/log directories, not code.
/outputs_stock_backup/
/outputs_stock_v2/
/logs/
